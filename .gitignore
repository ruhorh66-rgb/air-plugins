# Secrets — never commit
.env
*.env
**/.env
*.key
*.pem
.credentials.json

# Filled-in profile configs — carry private vault paths, project names and
# proprietary house standards. Only *.example.toml may be published.
legal-analysis/config/*.toml
!legal-analysis/config/*.example.toml
**/config/local.toml

# Node / build
node_modules/
.next/
dist/
build/

# Python runtime (should not live here anyway)
venv/
__pycache__/
*.pyc

# Heavy artifacts that belong on E:\-4-, never here
*.gguf
*.safetensors
*_cache/
downloads/
outputs/

# OS
.DS_Store
Thumbs.db

# Рантайм роя ruflo — статистика прогонов и состояние политик, не материал
# репозитория. Создаётся в каталоге запуска; проверено 14.08.2026: только
# neural/stats.json и policy/state.json, секретов нет.
.claude-flow/

# мусор прогонов тестов ломает claude plugin update (EPERM scandir)
.pytest_cache/
__pycache__/

# Локальные артефакты codex-review — рабочее состояние ревью-тулинга, не материал
# репозитория (log/verdict/streak меняются каждым прогоном ревью, session-heads —
# per-сессионные метки codex). Ранее случайно закоммичены (6e61f20, 41c5dfe) —
# untracked этим коммитом, файлы остались на диске.
.air/codex_review.log
.air/codex_review/
.air/codex_review_streak.json
.codex-verdict.txt
**/.air/session-heads/
