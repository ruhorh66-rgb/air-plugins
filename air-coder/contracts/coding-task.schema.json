{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AirCoder coding task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "product",
    "repo_root",
    "objective",
    "allowed_paths",
    "context_files",
    "acceptance_commands"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "expected_remote": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_head": {
      "type": [
        "string",
        "null"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "require_clean_start": {
      "type": "boolean"
    },
    "scarce_quota_burden": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "executor": {
      "type": "object"
    },
    "limits": {
      "type": "object"
    }
  }
}
